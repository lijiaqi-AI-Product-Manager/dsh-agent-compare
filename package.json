{
  "name": "dsh-agent-compare",
  "version": "1.1.0",
  "description": "同一需求，两版真跑：在 DSH 对话里比较、验证并审查采用。A DeepSeek Harness plugin for two implementations, live previews, shared checks and reviewed adoption.",
  "type": "module",
  "packageManager": "npm@12.2.2",
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "main": "lib/host/index.js",
  "types": "lib/host/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/host/index.d.ts",
      "default": "./lib/host/index.js"
    },
    "./client": "./lib/client.js",
    "./core": {
      "types": "./lib/core/index.d.ts",
      "default": "./lib/core/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "examples/vite-react-demo",
    "README*.md",
    "CONTRIBUTING.md",
    "docs",
    "LICENSE",
    "!examples/vite-react-demo/node_modules",
    "!examples/vite-react-demo/dist",
    "CHANGELOG.md",
    "assets",
    "screenshots.json",
    "!docs/media/*.mp4",
    "!docs/media/*.gif",
    "!docs/media/social-preview.png",
    "!assets/readme",
    "!docs/measurements",
    "!docs/media/manifest.json",
    "!docs/demo.md",
    "!docs/first-use.md",
    "!docs/distribution*.md",
    "!docs/media/history",
    "!docs/media/screenshots/0*.png"
  ],
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0",
    "dsh": ">=0.2.1-rc.3 <0.3.0-0"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\" && tsc -p tsconfig.json && tsc -p tsconfig.client.json && node scripts/wrap-client.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "check:docs": "node scripts/check-docs.mjs",
    "test": "npm run build && vitest run",
    "test:coverage": "npm run build && vitest run --coverage",
    "test:ui": "npm run build && node scripts/test-ui.mjs && node scripts/test-locales.mjs",
    "test:runtime": "npm run build && node scripts/test-runtime.mjs",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "prepack": "npm run build",
    "check:distribution": "node scripts/check-distribution.mjs",
    "check:prebuilt": "node scripts/check-prebuilt.mjs",
    "test:fast": "npm run build && vitest run --project unit",
    "test:integration": "npm run build && vitest run --project integration",
    "check:test-projects": "node scripts/check-test-projects.mjs",
    "test:managers": "npm run build && node scripts/test-managers.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "parallel-agents",
    "git-worktree",
    "live-preview",
    "blind-test",
    "code-comparison",
    "vite",
    "react",
    "frontend-tools",
    "ab-testing",
    "workflow"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-agent": "^0.2.1-rc.1",
    "@deepseek-ai/dsh-client-ui-chat": "^0.2.1-rc.1",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.2.1-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.1-rc.1",
    "@deepseek-ai/dsh-host-webserver": "^0.2.1-rc.1",
    "@deepseek-ai/dsh-llm": "^0.2.1-rc.1",
    "@deepseek-ai/dsh-tools": "^0.2.1-rc.1",
    "react": "^18.3.1 || ^19.3.1",
    "@deepseek-ai/dsh-sandbox": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-subprocess": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-win32-process": "^0.2.1-rc.3"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-slots": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-conversation": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-chat": {
      "optional": true
    },
    "@deepseek-ai/dsh-sandbox": {
      "optional": true
    },
    "@deepseek-ai/dsh-subprocess": {
      "optional": true
    },
    "@deepseek-ai/dsh-win32-process": {
      "optional": true
    }
  },
  "optionalDependencies": {
    "playwright-core": "^1.64.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "axe-core": "^4.14.0",
    "esbuild": "^0.28.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat"
      ],
      "platform": "web"
    },
    "manifestVersion": 1
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lijiaqi-AI-Product-Manager/dsh-agent-compare.git"
  },
  "homepage": "https://github.com/lijiaqi-AI-Product-Manager/dsh-agent-compare#readme",
  "bugs": "https://github.com/lijiaqi-AI-Product-Manager/dsh-agent-compare/issues"
}
